# Leave unset: the app calls /api on its own origin (the server hosts the
# built app; `npm run dev` proxies /api to http://localhost:4000).
# Set only if the server runs on a different host.
# VITE_API_BASE=https://api.example.org

# Optional — phone number encoded in the desk's WhatsApp opt-in QR code.
# Defaults to a placeholder since this build has no real WhatsApp Business number.
VITE_WHATSAPP_DEMO_NUMBER=910000000000
